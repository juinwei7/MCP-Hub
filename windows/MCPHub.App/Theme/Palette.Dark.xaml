<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      深色。key 必須和 Palette.xaml 完全一致 —— 少一個就會在切換主題時
      丟出 XamlParseException,而且是執行期才炸。

      色值不是把淺色反轉。反轉會讓語意色在深底上失去區辨度:例如反轉後的
      「健康綠」在深底上會變成幾乎看不出是綠色的濁色。所以三個語意色和強調色
      都另外調過,提高明度與飽和度以在深底上站得住。
    -->

    <Color x:Key="GroundColor">#0E1315</Color>
    <Color x:Key="SurfaceColor">#161D20</Color>
    <Color x:Key="SunkenColor">#11171A</Color>

    <Color x:Key="InkColor">#E7EEF0</Color>
    <Color x:Key="Ink2Color">#9EACB0</Color>
    <Color x:Key="Ink3Color">#6F7D81</Color>

    <Color x:Key="LineColor">#232D31</Color>
    <Color x:Key="LineSoftColor">#1B2326</Color>

    <Color x:Key="AccentColor">#47B6C4</Color>

    <Color x:Key="OkColor">#58B183</Color>
    <Color x:Key="WarnColor">#D0952F</Color>
    <Color x:Key="DownColor">#E0705E</Color>
    <Color x:Key="OffColor">#5A676B</Color>

    <SolidColorBrush x:Key="Ground"   Color="{StaticResource GroundColor}"/>
    <SolidColorBrush x:Key="Surface"  Color="{StaticResource SurfaceColor}"/>
    <SolidColorBrush x:Key="Sunken"   Color="{StaticResource SunkenColor}"/>
    <SolidColorBrush x:Key="Ink"      Color="{StaticResource InkColor}"/>
    <SolidColorBrush x:Key="Ink2"     Color="{StaticResource Ink2Color}"/>
    <SolidColorBrush x:Key="Ink3"     Color="{StaticResource Ink3Color}"/>
    <SolidColorBrush x:Key="Line"     Color="{StaticResource LineColor}"/>
    <SolidColorBrush x:Key="LineSoft" Color="{StaticResource LineSoftColor}"/>
    <SolidColorBrush x:Key="Accent"   Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="Ok"       Color="{StaticResource OkColor}"/>
    <SolidColorBrush x:Key="Warn"     Color="{StaticResource WarnColor}"/>
    <SolidColorBrush x:Key="Down"     Color="{StaticResource DownColor}"/>
    <SolidColorBrush x:Key="Off"      Color="{StaticResource OffColor}"/>

    <SolidColorBrush x:Key="AccentWash" Color="{StaticResource AccentColor}" Opacity="0.16"/>
    <SolidColorBrush x:Key="DownWash"   Color="{StaticResource DownColor}"   Opacity="0.10"/>
    <SolidColorBrush x:Key="WarnWash"   Color="{StaticResource WarnColor}"   Opacity="0.10"/>
    <SolidColorBrush x:Key="HoverWash"  Color="{StaticResource LineColor}"   Opacity="0.55"/>

</ResourceDictionary>
