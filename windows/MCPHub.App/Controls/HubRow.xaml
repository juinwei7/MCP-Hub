<UserControl x:Class="MCPHub.App.Controls.HubRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      所有清單共用的列骨架。

      狀態是列首的色條,不是浮空的圓點 —— 色條貼齊列的前緣,像混音台的通道條,
      掃一眼就知道哪幾條是通的。停用的下游不給顏色只是變淡:它不是壞掉,
      不該和異常同一個視覺層級。
    -->
    <Grid x:Name="Root" Height="42" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Rectangle x:Name="Rail" Grid.Column="0" Fill="Transparent"/>

        <StackPanel x:Name="TextStack" Grid.Column="1"
                    VerticalAlignment="Center" Margin="15,0,12,0">
            <TextBlock x:Name="TitleText"
                       FontFamily="Segoe UI, Microsoft JhengHei UI"
                       FontSize="13.5" FontWeight="SemiBold"
                       Foreground="{DynamicResource Ink}"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="DetailText" Margin="0,1,0,0"
                       TextTrimming="CharacterEllipsis"
                       Visibility="Collapsed"/>
        </StackPanel>

        <ContentPresenter x:Name="TrailingHost" Grid.Column="2"
                          VerticalAlignment="Center" Margin="0,0,16,0"/>

        <Rectangle Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom"
                   Fill="{DynamicResource LineSoft}"/>
    </Grid>
</UserControl>
