<UserControl x:Class="MCPHub.App.Controls.AlertLine"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
      有事才浮上來,而且直接帶修復動作。
      一切正常時這一行完全不存在 —— 永遠掛著「0 異常」是噪音。
    -->
    <Border x:Name="Bg" Padding="18,9,18,9">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="BorderBrush" Value="{DynamicResource LineSoft}"/>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="Glyph" Grid.Column="0" Margin="0,0,9,0"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="12" VerticalAlignment="Center"/>

            <TextBlock x:Name="Message" Grid.Column="1"
                       FontFamily="Segoe UI, Microsoft JhengHei UI"
                       FontSize="12.5" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <Button x:Name="Action" Grid.Column="2"
                    Style="{DynamicResource LinkButton}"
                    Visibility="Collapsed" Click="OnAction"/>
        </Grid>
    </Border>
</UserControl>
